<launch>

  <arg name="world_name" default="garage"/>
  <arg name="publish2dMap" default="false"/>
  <arg name="mapYamlFile" default="/home/nv/autonomy_stack_go2/src/utilities/odin_maps/siat-f10/siat-f10.yaml"/>
  <arg name="mapTopic" default="/map"/>
  <arg name="mapFrame" default="map"/>

  <node pkg="visualization_tools" exec="visualizationTools" name="visualizationTools" output="screen">
    <param name="metricFile" value="$(find-pkg-prefix vehicle_simulator)/log/metrics" />
    <param name="trajFile" value="$(find-pkg-prefix vehicle_simulator)/log/trajectory" />
    <param name="pcdFile" value="$(find-pkg-prefix vehicle_simulator)/log/pointcloud" />
    <param name="mapFile" value="$(find-pkg-prefix vehicle_simulator)/mesh/$(var world_name)/map.ply" />
    <param name="overallMapVoxelSize" value="0.1" />
    <param name="exploredAreaVoxelSize" value="0.2" />
    <param name="exploredVolumeVoxelSize" value="1.0" />
    <param name="transInterval" value="0.1" />
    <param name="yawInterval" value="0.17" />
    <param name="overallMapDisplayInterval" value="2" />
    <param name="exploredAreaDisplayInterval" value="1" />
    <param name="saveMetric" value="false" />
    <param name="saveTraj" value="false" />
    <param name="savePcd" value="false" />
  </node>

  <!-- <node pkg="visualization_tools" exec="static_occupancy_map_publisher" name="static_occupancy_map_publisher" output="screen" if="$(var publish2dMap)">
    <param name="map_yaml_file" value="$(var mapYamlFile)" />
    <param name="topic_name" value="$(var mapTopic)" />
    <param name="frame_id" value="$(var mapFrame)" />
    <param name="publish_delay_ms" value="1000" />
  </node> -->

  <!--node pkg="visualization_tools" exec="realTimePlot.py" name="realTimePlot" output="screen"/-->

</launch>
